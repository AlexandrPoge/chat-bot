# Optional: enables live answers from the server-side /api/chat route.
# Do not expose this value in browser code or commit a real .env.local file.
OPENAI_API_KEY=

# Use a model enabled for your OpenAI project.
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables persistent accounts, bots, sources, and conversations.
# The publishable key can be used in browser code. Keep the secret key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
